    <script>
        // Store State
        let cart = [];

        // Initialize icons on load
        window.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            updateCartUI();
        });

        // Toggle Mobile Menu
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            const openIcon = document.getElementById('menu-icon-open');
            const closeIcon = document.getElementById('menu-icon-close');
            
            menu.classList.toggle('hidden');
            openIcon.classList.toggle('hidden');
            closeIcon.classList.toggle('hidden');
        }

        // Filter Products in Catalog
        function filterProducts(category) {
            const cards = document.querySelectorAll('.product-card');
            const buttons = document.querySelectorAll('.filter-btn');

            buttons.forEach(btn => {
                btn.classList.remove('bg-amber-600', 'text-white', 'active');
                btn.classList.add('bg-stone-100', 'text-stone-700');
            });

            event.target.classList.remove('bg-stone-100', 'text-stone-700');
            event.target.classList.add('bg-amber-600', 'text-white', 'active');

            cards.forEach(card => {
                if (category === 'todos' || card.dataset.category === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Toggle FAQ Accordions
        function toggleFaq(button) {
            const content = button.nextElementSibling;
            const icon = button.querySelector('i');
            const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';

            // Close all items
            document.querySelectorAll('#faq-accordion > div').forEach(item => {
                const c = item.querySelector('div');
                const i = item.querySelector('i');
                if (c) c.style.maxHeight = '0px';
                if (i) i.style.transform = 'rotate(0deg)';
            });

            // Open clicked item if closed
            if (!isOpen) {
                content.style.maxHeight = content.scrollHeight + 'px';
                if (icon) icon.style.transform = 'rotate(180deg)';
            }
        }

        // Cart Drawer Control
        function toggleCart(open) {
            const drawer = document.getElementById('cart-drawer');
            const backdrop = document.getElementById('cart-backdrop');

            if (open) {
                backdrop.classList.remove('opacity-0', 'pointer-events-none');
                drawer.classList.remove('translate-x-full');
            } else {
                backdrop.classList.add('opacity-0', 'pointer-events-none');
                drawer.classList.add('translate-x-full');
            }
        }

        // Add Product to Cart
        function addToCart(id, title, price, details) {
            const existingIndex = cart.findIndex(item => item.id === id);

            if (existingIndex > -1) {
                cart[existingIndex].quantity += 1;
            } else {
                cart.push({
                    id: id,
                    title: title,
                    price: price,
                    details: details,
                    quantity: 1
                });
            }

            updateCartUI();
            showToast(`¡Añadido: ${title}!`);
            toggleCart(true);
        }

        // Modify Quantity
        function updateQuantity(id, change) {
            const item = cart.find(i => i.id === id);
            if (!item) return;

            item.quantity += change;

            if (item.quantity <= 0) {
                cart = cart.filter(i => i.id !== id);
            }

            updateCartUI();
        }

        // Remove Item
        function removeFromCart(id) {
            cart = cart.filter(i => i.id !== id);
            updateCartUI();
        }

        // Update Cart Drawer DOM & Totals
        function updateCartUI() {
            const cartItemsContainer = document.getElementById('cart-items');
            const cartCounter = document.getElementById('cart-counter');
            const cartSubtotal = document.getElementById('cart-subtotal');
            const cartTotal = document.getElementById('cart-total');

            // Total count calculation
            const totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
            cartCounter.textContent = totalCount;

            // Total price calculation
            const totalAmount = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            cartSubtotal.textContent = `$${totalAmount.toFixed(2)}`;
            cartTotal.textContent = `$${totalAmount.toFixed(2)}`;

            // Render Cart List
            if (cart.length === 0) {
                cartItemsContainer.innerHTML = `
                    <div class="text-center py-12 text-stone-400">
                        <i data-lucide="shopping-bag" class="w-12 h-12 mx-auto mb-3 opacity-40"></i>
                        <p class="font-bold text-stone-600">Tu carrito está vacío</p>
                        <p class="text-xs mt-1">¡Añade Curcu-Amador o cúrcuma en polvo para comenzar!</p>
                    </div>
                `;
            } else {
                cartItemsContainer.innerHTML = cart.map(item => `
                    <div class="flex items-center justify-between bg-stone-50 p-3.5 rounded-2xl border border-stone-200">
                        <div class="flex-1 pr-3">
                            <h4 class="font-bold text-sm text-stone-900">${item.title}</h4>
                            <p class="text-xs text-stone-500">$${item.price.toFixed(2)} c/u</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="flex items-center bg-white rounded-xl border border-stone-300">
                                <button onclick="updateQuantity('${item.id}', -1)" class="px-2 py-1 text-stone-600 hover:text-amber-700 font-bold text-sm">-</button>
                                <span class="px-2 font-bold text-xs text-stone-800">${item.quantity}</span>
                                <button onclick="updateQuantity('${item.id}', 1)" class="px-2 py-1 text-stone-600 hover:text-amber-700 font-bold text-sm">+</button>
                            </div>
                            <button onclick="removeFromCart('${item.id}')" class="text-stone-400 hover:text-red-500 p-1">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                `).join('');
            }

            lucide.createIcons();
        }

        // Toast Notification Function
        function showToast(message) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast-animate bg-stone-900 text-white px-4 py-3 rounded-2xl shadow-xl flex items-center gap-2 border border-amber-500/40 text-sm font-semibold pointer-events-auto';
            toast.innerHTML = `
                <i data-lucide="check-circle" class="w-4 h-4 text-amber-400"></i>
                <span>${message}</span>
            `;
            container.appendChild(toast);
            lucide.createIcons();

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Send WhatsApp Order
        function sendWhatsAppOrder(e) {
            e.preventDefault();

            if (cart.length === 0) {
                showToast("⚠️ Agrega al menos un producto al carrito");
                return;
            }

            const name = document.getElementById('cust-name').value;
            const address = document.getElementById('cust-address').value;
            const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0).toFixed(2);

            let orderText = `*NUEVO PEDIDO DE CÚRCUMA / CURCU-AMADOR*%0A%0A`;
            orderText += `*Cliente:* ${encodeURIComponent(name)}%0A`;
            orderText += `*Dirección:* ${encodeURIComponent(address)}%0A%0A`;
            orderText += `*Detalle de Pedido:*%0A`;

            cart.forEach(item => {
                orderText += `- ${item.quantity}x ${encodeURIComponent(item.title)} ($${(item.price * item.quantity).toFixed(2)})%0A`;
            });

            orderText += `%0A*TOTAL:* $${total}%0A`;
            orderText += `*Envío:* GRATIS%0A%0A`;
            orderText += `Por favor confirmen mi pedido para la entrega.`;

            // WhatsApp link (Replace with actual business phone number)
            const whatsappNumber = "34600000000"; 
            window.open(`https://wa.me/${whatsappNumber}?text=${orderText}`, '_blank');
        }
    </script>
